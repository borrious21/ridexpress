<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RiderXpress</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', sans-serif;
    }

    body {
      background-color: #fafafa;
      color: #111827;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 3rem;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 700;
      color: #2563eb;
    }

    nav a {
      margin: 0 1rem;
      text-decoration: none;
      color: #4b5563;
      font-weight: 500;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .sign-in-btn {
      padding: 0.5rem 1rem;
      border: 1px solid #2563eb;
      border-radius: 2rem;
      color: #2563eb;
      font-weight: 500;
      background: transparent;
      cursor: pointer;
    }

    main {
      text-align: center;
      margin-top: 3rem;
    }

    h1 {
      font-size: 2rem;
      font-weight: 700;
    }

    p {
      margin-top: 0.5rem;
      color: #6b7280;
    }

    .auth-card {
      max-width: 400px;
      margin: 2rem auto;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 0 8px rgba(0, 0, 0, 0.05);
      overflow: hidden;
    }

    .tabs {
      display: flex;
      border-bottom: 1px solid #e5e7eb;
    }

    .tab {
      flex: 1;
      text-align: center;
      padding: 1rem;
      font-weight: 600;
      cursor: pointer;
    }

    .tab.active {
      background-color: #fff;
      border-bottom: 2px solid #2563eb;
    }

    .form {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .form input {
      padding: 0.75rem;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 0.95rem;
    }

    .forgot {
      text-align: right;
      font-size: 0.85rem;
    }

    .forgot a {
      color: #2563eb;
      text-decoration: none;
    }

    .submit-btn {
      background-color: #2563eb;
      color: #fff;
      padding: 0.75rem;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      border: none;
    }

    .or {
      text-align: center;
      font-size: 0.85rem;
      color: #6b7280;
    }

    .social-icons {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 1rem;
    }

    .social-icons button {
      border: 1px solid #e5e7eb;
      padding: 0.5rem 0.75rem;
      border-radius: 8px;
      background-color: #fff;
      cursor: pointer;
      font-size: 1.1rem;
    }

    .privacy {
      font-size: 0.75rem;
      color: #6b7280;
      margin-top: 1rem;
    }

    .privacy a {
      color: #2563eb;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <header>
    <div class="logo">RiderXpress</div>
    <nav>
      <a href="#">Home</a>
      <a href="#">Vehicles</a>
      <a href="#">About</a>
      <a href="#">Contact</a>
    </nav>
    <div class="nav-right">
      <button class="sign-in-btn">Sign In</button>
    </div>
  </header>

  <main>
    <h1>Welcome to RiderXpress</h1>
    <p>Your journey to finding the perfect vehicle starts here</p>

    <div class="auth-card">
      <div class="tabs">
        <div class="tab active" onclick="showTab('login')">Login</div>
        <div class="tab" onclick="showTab('signup')">Sign Up</div>
      </div>

      <form id="login" class="form">
        <input type="email" placeholder="Enter your email" required />
        <input type="password" placeholder="Enter your password" required />
        <div class="forgot"><a href="#">Forgot password?</a></div>
        <button class="submit-btn">Login</button>
        <div class="or">Or continue with</div>
        <div class="social-icons">
          <button>&#9993;</button>
          <button>&#128187;</button>
          <button>&#xf09a;</button>
        </div>
      </form>

      <form id="signup" class="form" style="display: none">
        <input type="text" placeholder="Enter your full name" required />
        <input type="email" placeholder="Enter your email" required />
        <input type="password" placeholder="Create a password" required />
        <input type="password" placeholder="Confirm your password" required />
        <button class="submit-btn">Create Account</button>
        <div class="privacy">
          By signing up, you agree to our
          <a href="#">Terms of Service</a> and
          <a href="#">Privacy Policy</a>
        </div>
      </form>
    </div>
  </main>

  <script>
    function showTab(tab) {
      document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.form').forEach(el => (el.style.display = 'none'));
      document.getElementById(tab).style.display = 'flex';
      document.querySelector(`.tab[onclick="showTab('${tab}')"]`).classList.add('active');
    }
  </script>
</body>
</html>
